{
  "name": "cc-nexus",
  "version": "3.0.0",
  "description": "Universal Super-Agent Desktop Workstation (Beginner, Office & Developer Modes) powered by DeepSeek Super-Agent, Claude Code & OpenAI Codex",
  "keywords": [
    "claude-code",
    "openai-codex",
    "deepseek-super-agent",
    "desktop-app",
    "multi-agent",
    "office-productivity",
    "git-worktree",
    "mcp",
    "security-gate"
  ],
  "homepage": "https://github.com/PRY123-BOT/cc-nexus",
  "repository": {
    "type": "git",
    "url": "https://github.com/PRY123-BOT/cc-nexus.git"
  },
  "license": "MIT",
  "author": "PRY123-BOT <1402538243@qq.com>",
  "type": "module",
  "bin": {
    "cc-nexus": "./src/cli/index.ts"
  },
  "scripts": {
    "start": "bun run src/server/index.ts",
    "dev": "bun --watch run src/server/index.ts",
    "desktop": "bun run src/desktop/launcher.ts",
    "build:desktop": "bun build src/desktop/launcher.ts --compile --windows-hide-console --outfile dist/CC-Nexus-Desktop.exe",
    "studio": "bun run src/cli/index.ts studio",
    "cli": "bun run src/cli/index.ts",
    "doctor": "bun run src/cli/index.ts doctor",
    "audit": "bun run src/cli/index.ts audit --sample",
    "dream": "bun run src/cli/index.ts dream",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.0.0"
  }
}
